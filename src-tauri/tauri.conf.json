{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NortonMac",
  "version": "1.0.0",
  "identifier": "com.nortonmac.filemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Norton Commander (macOS)",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
